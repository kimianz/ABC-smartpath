# Configure in the hosting dashboard, never commit real values.
APP_ENV=public_demo
AI_PROVIDER=ollama_cloud
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=REPLACE_WITH_VERIFIED_CLOUD_MODEL
OLLAMA_API_KEY=
STAFF_TOKEN=
DATABASE_PATH=/var/data/smartpath.sqlite3
HF_HOME=/var/data/models
STATIC_DIR=/app/static
AI_TIMEOUT_SECONDS=60
